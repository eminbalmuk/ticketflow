@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var homeActive = currentController == "Home" ? "is-active" : "";
    var ticketsActive = currentController == "Tickets" ? "is-active" : "";
    var customersActive = currentController == "Customers" ? "is-active" : "";
    var adminActive = currentController == "Admin" ? "is-active" : "";
    var ticketsLabel = User.IsInRole("Customer") && !User.IsInRole("Support") && !User.IsInRole("Admin")
        ? "Taleplerim"
        : "Talepler";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TicketFlow</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ticketflow.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="line-loader" aria-hidden="true"></div>

    <header class="app-header">
        <nav class="navbar navbar-expand-sm app-navbar">
            <div class="container app-container">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img class="brand-logo" src="~/images/ticketflowlogo.png" alt="TicketFlow" asp-append-version="true" />
                    <span class="brand-company">MarunElectro</span>
                </a>
                <button class="navbar-toggler app-menu-button" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse app-nav-collapse">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav app-nav">
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @homeActive" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @ticketsActive" asp-area="" asp-controller="Tickets" asp-action="Index">@ticketsLabel</a>
                            </li>
                            @if (User.IsInRole("Support"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link app-nav-link @customersActive" asp-area="" asp-controller="Customers" asp-action="Index">Müşteri Ara</a>
                                </li>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link app-nav-link @adminActive" asp-area="" asp-controller="Admin" asp-action="Index">Admin</a>
                                </li>
                            }
                        </ul>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="app-main">
        <div class="container app-container">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container app-container">
            <span>© 2026 TicketFlow</span>
            <span class="footer-line" aria-hidden="true"></span>
            <span>Teknik destek akış yönetimi</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/gsap/gsap.min.js" asp-append-version="true"></script>
    <script src="~/lib/gsap/ScrollTrigger.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
