@model TicketDetailsViewModel

@{
    ViewData["Title"] = "Talep Detayı";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert app-alert alert-success page-enter" role="alert">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert app-alert alert-danger page-enter" role="alert">@errorMessage</div>
}

<div class="details-heading ticket-detail-heading page-enter">
    <div>
        <a class="back-link ticket-back-button" asp-action="Index">Taleplere dön</a>
        <p class="section-kicker"><span></span> Talep Detayı</p>
        <span class="ticket-id detail-ticket-id">#@Model.Id</span>
        <h1>@Model.Title</h1>
    </div>
</div>

<section class="ticket-panel elevated-panel page-enter page-enter-delay">
    <div class="meta-grid">
        <div>
            <span>Talep No</span>
            <strong>#@Model.Id</strong>
        </div>
        <div>
            <span>Mevcut durum</span>
            <strong><span class="status-badge @BadgeClass(Model.Status)">@Model.Status.GetDisplayName()</span></strong>
        </div>
        <div>
            <span>Müşteri</span>
            <strong>@Model.CustomerEmail</strong>
        </div>
        <div>
            <span>Destek sorumlusu</span>
            <strong>@(Model.AssignedSupportEmail ?? "Atanmadı")</strong>
        </div>
        <div>
            <span>Oluşturma</span>
            <strong>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong>
        </div>
        @if (Model.UpdatedAt.HasValue)
        {
            <div>
                <span>Son güncelleme</span>
                <strong>@Model.UpdatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong>
            </div>
        }
    </div>

    @if (Model.CanAssignSupport || Model.CanManage || Model.CanDelete)
    {
        <div class="details-actions ticket-panel-actions">
            @if (Model.CanAssignSupport)
            {
                <form asp-action="AssignSupport" asp-route-id="@Model.Id" method="post" class="assign-support-form">
                    <select class="form-select" name="supportUserId" aria-label="Destek sorumlusu seç">
                        <option value="">Atanmadı</option>
                        @foreach (var supportUser in Model.SupportUsers)
                        {
                            if (Model.AssignedSupportId == supportUser.Id)
                            {
                                <option value="@supportUser.Id" selected>@supportUser.DisplayName</option>
                            }
                            else
                            {
                                <option value="@supportUser.Id">@supportUser.DisplayName</option>
                            }
                        }
                    </select>
                    <button type="submit" class="btn btn-primary">Support Ata</button>
                </form>
            }

            @if (Model.CanManage)
            {
                <form asp-action="Take" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-outline-primary">Üstlen</button>
                </form>
                <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="status-form">
                    <select class="form-select" name="status">
                        @foreach (var statusValue in Enum.GetValues<TicketStatus>())
                        {
                            if (Model.Status == statusValue)
                            {
                                <option value="@statusValue" selected>@statusValue.GetDisplayName()</option>
                            }
                            else
                            {
                                <option value="@statusValue">@statusValue.GetDisplayName()</option>
                            }
                        }
                    </select>
                    <button type="submit" class="btn btn-primary">Güncelle</button>
                </form>
            }

            @if (Model.CanDelete)
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bu talebi silmek istediğinizden emin misiniz?');">
                    <button type="submit" class="btn btn-outline-danger btn-icon" aria-label="Talebi sil" title="Talebi sil">
                        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none">
                            <path d="M3 6h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            <path d="M8 6V4.75A1.75 1.75 0 0 1 9.75 3h4.5A1.75 1.75 0 0 1 16 4.75V6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            <path d="M19 6l-.85 13.05A2 2 0 0 1 16.15 21h-8.3a2 2 0 0 1-2-1.95L5 6" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                            <path d="M10 11v5M14 11v5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </button>
                </form>
            }
        </div>
    }

    <div class="description-block">
        <span class="feature-line" aria-hidden="true"></span>
        <h2>Açıklama</h2>
        <p>@Model.Description</p>
    </div>
</section>

<section class="reply-section page-enter page-enter-delay">
    <div class="section-heading">
        <p class="section-kicker"><span></span> Cevap Akışı</p>
        <h2>Cevaplar</h2>
    </div>
    @if (!Model.Replies.Any())
    {
        <div class="empty-state compact-empty">
            <span class="empty-mark" aria-hidden="true"></span>
            <p>Bu talebe henüz cevap yazılmadı.</p>
        </div>
    }
    else
    {
        <div class="reply-list">
            @foreach (var reply in Model.Replies)
            {
                <article class="reply-item">
                    <div class="reply-meta">
                        <strong>@reply.AuthorEmail</strong>
                        <span>@reply.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    <p>@reply.Message</p>
                </article>
            }
        </div>
    }
</section>

<section class="ticket-panel elevated-panel page-enter page-enter-delay">
    <div class="section-heading">
        <p class="section-kicker"><span></span> Yanıt</p>
        <h2>Cevap Yaz</h2>
    </div>
    <form asp-action="Reply" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
        <div class="form-field">
            <label for="Message" class="form-label">Cevap</label>
            <textarea class="form-control" rows="4" id="Message" name="Message" placeholder="Yanıtınızı yazın">@Model.NewReply.Message</textarea>
            <span class="text-danger">@Html.ValidationMessage("Message")</span>
        </div>
        <button type="submit" class="btn btn-primary">Cevap Ekle</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    private static string BadgeClass(TicketStatus status)
    {
        return status switch
        {
            TicketStatus.Open => "status-open",
            TicketStatus.Resolved => "status-resolved",
            TicketStatus.Closed => "status-closed",
            _ => "status-muted"
        };
    }
}
