@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="page-heading page-enter">
    <div>
        <p class="section-kicker"><span></span> Admin Merkezi</p>
        <h1>Yönetim</h1>
        <p>Müşteri taleplerini inceleyin ve destek kullanıcılarını yönetin.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Tickets" asp-action="Index">Tüm Talepler</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert app-alert alert-success page-enter" role="alert">@successMessage</div>
}

<section class="summary-grid page-enter page-enter-delay" aria-label="Admin özet">
    <article class="summary-tile">
        <span>Açık talep</span>
        <strong>@Model.OpenTicketCount</strong>
    </article>
    <article class="summary-tile">
        <span>Atanmamış</span>
        <strong>@Model.UnassignedTicketCount</strong>
    </article>
    <article class="summary-tile">
        <span>Support</span>
        <strong>@Model.SupportUsers.Count</strong>
    </article>
</section>

<section class="admin-grid page-enter page-enter-delay">
    <div class="ticket-panel elevated-panel">
        <div class="section-heading">
            <p class="section-kicker"><span></span> Müşteri Kontrolü</p>
            <h2>Müşteri Ara</h2>
        </div>

        <form method="get" class="admin-search-form">
            <div class="form-field">
                <label class="form-label" for="customerQuery">E-posta veya kullanıcı adı</label>
                <input class="form-control" id="customerQuery" name="customerQuery" value="@Model.CustomerQuery" placeholder="customer@ticketflow.local" />
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" type="submit">Ara</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Temizle</a>
            </div>
        </form>
    </div>

    <div class="ticket-panel elevated-panel">
        <div class="section-heading">
            <p class="section-kicker"><span></span> Support Yetkisi</p>
            <h2>Support Yap</h2>
        </div>

        <form asp-action="MakeSupport" method="post">
            <input type="hidden" name="customerQuery" value="@Model.CustomerQuery" />
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary" role="alert"></div>

            <div class="form-field">
                <label asp-for="SupportInput.Email" class="form-label"></label>
                <input asp-for="SupportInput.Email" class="form-control" autocomplete="email" placeholder="support@ticketflow.local" />
                <span asp-validation-for="SupportInput.Email" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="SupportInput.UserName" class="form-label"></label>
                <input asp-for="SupportInput.UserName" class="form-control" autocomplete="username" placeholder="support" />
                <span asp-validation-for="SupportInput.UserName" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="SupportInput.FullName" class="form-label"></label>
                <input asp-for="SupportInput.FullName" class="form-control" autocomplete="name" placeholder="Destek Kullanıcı" />
                <span asp-validation-for="SupportInput.FullName" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="SupportInput.TemporaryPassword" class="form-label"></label>
                <input asp-for="SupportInput.TemporaryPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="SupportInput.TemporaryPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Support Yetkisi Ver</button>
        </form>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.CustomerQuery))
{
    <section class="page-enter page-enter-delay">
        <div class="section-heading">
            <p class="section-kicker"><span></span> Arama Sonucu</p>
            <h2>Müşteri Talepleri</h2>
        </div>

        @if (!Model.CustomerResults.Any())
        {
            <div class="empty-state compact-empty">
                <span class="empty-mark" aria-hidden="true"></span>
                <p>Bu bilgiyle eşleşen müşteri bulunamadı.</p>
            </div>
        }
        else
        {
            <div class="admin-result-list">
                @foreach (var customer in Model.CustomerResults)
                {
                    <article class="ticket-panel elevated-panel">
                        <div class="admin-result-heading">
                            <div>
                                <h3>@customer.FullName</h3>
                                <p>@customer.UserName · @customer.Email</p>
                            </div>
                            <div class="admin-counts" aria-label="Talep sayıları">
                                <span>Açık @customer.OpenCount</span>
                                <span>Çözüldü @customer.ResolvedCount</span>
                                <span>Kapandı @customer.ClosedCount</span>
                            </div>
                        </div>

                        @if (!customer.Tickets.Any())
                        {
                            <div class="empty-state compact-empty">
                                <span class="empty-mark" aria-hidden="true"></span>
                                <p>Bu müşterinin talebi yok.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table app-table align-middle">
                                    <thead>
                                        <tr>
                                            <th>Başlık</th>
                                            <th>Durum</th>
                                            <th>Destek</th>
                                            <th>Oluşturma</th>
                                            <th class="text-end">Aksiyon</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ticket in customer.Tickets)
                                        {
                                            <tr>
                                                <td><span class="table-title">@ticket.Title</span></td>
                                                <td><span class="status-badge @BadgeClass(ticket.Status)">@ticket.Status.GetDisplayName()</span></td>
                                                <td>@(ticket.AssignedSupportEmail ?? "Atanmadı")</td>
                                                <td>@ticket.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                                <td class="text-end">
                                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">Detay</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>
}

<section class="ticket-panel elevated-panel page-enter page-enter-delay">
    <div class="section-heading">
        <p class="section-kicker"><span></span> Yetkili Kullanıcılar</p>
        <h2>Support Listesi</h2>
    </div>

    @if (!Model.SupportUsers.Any())
    {
        <div class="empty-state compact-empty">
            <span class="empty-mark" aria-hidden="true"></span>
            <p>Henüz support kullanıcısı yok.</p>
        </div>
    }
    else
    {
        <div class="support-list">
            @foreach (var supportUser in Model.SupportUsers)
            {
                <div>
                    <strong>@supportUser.FullName</strong>
                    <span>@supportUser.UserName · @supportUser.Email</span>
                </div>
            }
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    private static string BadgeClass(TicketStatus status)
    {
        return status switch
        {
            TicketStatus.Open => "status-open",
            TicketStatus.Resolved => "status-resolved",
            TicketStatus.Closed => "status-closed",
            _ => "status-muted"
        };
    }
}
